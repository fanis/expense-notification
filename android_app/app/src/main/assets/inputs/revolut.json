{
  "id": "revolut",
  "displayName": "Revolut",
  "enabled": true,
  "priority": 10,
  "match": {
    "packages": [
      "com.revolut.revolut",
      "com.revolut.business"
    ]
  },
  "transforms": [
    "normalizeAmount",
    "multiCurrency"
  ],
  "rules": [
    {
      "name": "money-received",
      "type": "regex",
      "pattern": "^\\s*Sent\\s+you\\s+(?<currency>\\p{Sc})\\s*(?<amount>(?:[0-9]{1,3}(?:[.,][0-9]{3})+[.,][0-9]{2}(?![0-9])|[0-9]{1,3}(?:[.,][0-9]{3})+(?![0-9])|[0-9]+(?:[.,][0-9]{2})?))",
      "flags": [
        "caseInsensitive",
        "multiline"
      ],
      "merchantSource": "title",
      "output": {
        "paymentMethod": "Electronic Transfer",
        "type": "INCOME"
      }
    },
    {
      "name": "default",
      "type": "amountFallback",
      "merchantSource": "firstNonNoiseLine",
      "output": {
        "paymentMethod": "Credit Card",
        "category": "@keyword"
      }
    }
  ],
  "tests": [
    {
      "name": "completed spend",
      "package": "com.revolut.revolut",
      "app": "Revolut",
      "title": "SAMPLE UTILITY",
      "body": "You spent €33.95\nEUR balance: €543.21",
      "expect": {
        "amount": "33.95",
        "currency": "EUR",
        "merchant": "SAMPLE UTILITY",
        "paymentMethod": "Credit Card"
      }
    },
    {
      "name": "money received from a person",
      "package": "com.revolut.revolut",
      "app": "Revolut",
      "title": "SAMPLE SENDER",
      "body": "Sent you €20. Tap to say thank you 💰",
      "expect": {
        "amount": "20",
        "currency": "EUR",
        "merchant": "SAMPLE SENDER",
        "category": "Income",
        "paymentMethod": "Electronic Transfer",
        "type": "INCOME"
      }
    },
    {
      "name": "low-balance top-up prompt is rejected",
      "package": "com.revolut.revolut",
      "app": "Revolut",
      "title": "EUR 30 needed",
      "body": "If you can, add money now so your next transaction is covered",
      "expect": {
        "matched": false
      }
    },
    {
      "name": "pending approval prompt is rejected",
      "package": "com.revolut.business",
      "app": "Business",
      "title": "Verify a payment",
      "body": "A card payment of €112.14 to SAMPLE UTILITY is waiting for your approval. Tap to start",
      "expect": {
        "matched": false
      }
    }
  ]
}
